/* Input helper functions */
int readInt(const char *message)
{
    char line[SIZE], extra;
    int value;

    while (1) {
        printf("%s", message);
        if (fgets(line, sizeof(line), stdin) != NULL &&
            sscanf(line, "%d %c", &value, &extra) == 1) {
            return value;
        }
        printf("Please enter a valid whole number.\n");
    }
}

float readFloat(const char *message)
{
    char line[SIZE], extra;
    float value;

    while (1) {
        printf("%s", message);
        if (fgets(line, sizeof(line), stdin) != NULL &&
            scanf(line, "%f %c", &value, &extra) == 1 && value >= 0) {
            return value;
        }
        printf("Please enter a valid non-negative amount.\n");
    }
}

void readText(const char *message, char text[], int size)
{
    size_t length;
    int ch;

    printf("%s", message);
    if (fgets(text, size, stdin) == NULL) {
        text[0] = '\0';
        return;
    }

    length = strlen(text);
    if (length > 0 && text[length - 1] == '\n') {
        text[length - 1] = '\0';
    } else {
        while ((ch = getchar()) != '\n' && ch != EOF) {

        }
    }
}

void waitEnter(void)
{
    char line[8];
    printf("\nPress Enter to continue...");
    fgets(line, sizeof(line), stdin);
}

/* Login credentials for demonstration: admin / 1234 */
int login(void)
{
    char username[SIZE], password[SIZE];

    readText("Username: ", username, SIZE);
    readText("Password: ", password, SIZE);

    if (strcmp(username, "admin") == 0 &&
        strcmp(password, "1234") == 0) {
        printf("Login successful.\n");
        return 1;
    }
    return 0;
}

/* Main menu */
void mainMenu(void)
{
    int choice;

    do {
        printf("1. Student Records\n");
        printf("2. Room Management\n");
        printf("3. Payments and Fee Status\n");
        printf("4. Complaint Management\n");
        printf("5. Visitor Tracking\n");
        printf("6. Service Requests\n");
        printf("7. Generate Report\n");
        printf("0. Exit\n");

        choice = readInt("Enter your choice: ");

        switch (choice) {
            case 1: studentMenu(); break;
            case 2: roomMenu(); break;
            case 3: paymentMenu(); break;
            case 4: complaintMenu(); break;
            case 5: visitorMenu(); break;
            case 6: serviceRequestMenu(); break;
            case 7: generateReport(); break;
            case 0: printf("Logging out...\n"); break;
            default: printf("Invalid choice.\n");
        }

        if (choice != 0) {
            waitEnter();
        }
    } while (choice != 0);
}

