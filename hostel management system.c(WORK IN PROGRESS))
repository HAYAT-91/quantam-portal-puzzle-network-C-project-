/* Student records file handling */
int studentExists(int id)
{
    FILE *fp = fopen("students.dat", "rb");
    Student s;

    if (fp == NULL) return 0;

    while (fread(&s, sizeof(Student), 1, fp) == 1) {
        if (s.id == id) {
            fclose(fp);
            return 1;
        }
    }

    fclose(fp);
    return 0;
}

